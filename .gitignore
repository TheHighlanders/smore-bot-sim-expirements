# The user's global ~/.gitignore ignores **/*.md. In THIS project the markdown
# is a deliverable (docs, the offline citation references, the citation policy),
# so re-include it. Project .gitignore takes precedence over the global one.
!**/*.md

# PlatformIO
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Host build output
build/

# Custom chip build output
wokwi/chips/*/dist/

# Shared headers get copied next to chip sources during CI builds only —
# never commit the copies.
wokwi/chips/p1-base-controller/src/base_model.h
wokwi/chips/p1-base-controller/src/module_db.h

# OS cruft
.DS_Store
