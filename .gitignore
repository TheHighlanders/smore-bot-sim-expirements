# Corporate CA certs exported into the dev-container trust dir are local,
# network-specific trust material — keep them out of the repo (the .gitkeep and
# the Dockerfile mechanism are what's tracked).
.devcontainer/certs/*.crt

# The user's global ~/.gitignore ignores **/*.md. In THIS project the markdown
# is a deliverable (docs, the offline citation references, the citation policy),
# so re-include it. Project .gitignore takes precedence over the global one.
!**/*.md

# PlatformIO
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/ipch/
# NOTE: .vscode/launch.json is intentionally tracked (curated Wokwi debug
# config). If PlatformIO regenerates it, keep the "Wokwi: Debug RP2040" entry.

# Host build output
build/

# GitHub Pages app: compiled controllers + generated layout meta are build
# artifacts (derived from controller/src + layouts). Rebuild with `make app`;
# CI builds them fresh before deploy.
docs/app/controller.wasm
docs/app/wasm/
docs/app/layouts/

# Generated typed contract + layout meta (codegen from controller/layouts/*.json).
# Source of truth is the layout JSON; regenerate with `make -C controller codegen`.
controller/include/smores/generated/
controller/generated/

# In-browser C++ toolchain (clang+lld+sysroot compiled to wasm) — large,
# machine-agnostic third-party binaries. Fetch with tools/get-wasm-clang.sh.
docs/app/vendor/

# Repo-local toolchains (wasi-sdk downloaded by tools/get-wasi-sdk.sh) — large,
# machine/arch-specific; re-download with `make chip-local`.
.toolchains/

# Custom chip build output
wokwi/chips/*/dist/

# Shared headers get copied next to chip sources during CI builds only —
# never commit the copies.
wokwi/chips/p1-base-controller/src/base_model.h
wokwi/chips/p1-base-controller/src/module_db.h

# OS cruft
.DS_Store
